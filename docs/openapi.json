{
  "components": {
    "schemas": {
      "CheckRequest": {
        "description": "Look up by ``npi``, or by ``last_name`` plus ``state``.",
        "properties": {
          "first_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "ALPHA"
            ],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "SAMPLE"
            ],
            "title": "Last Name"
          },
          "npi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "1990000014"
            ],
            "title": "Npi"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Two-letter USPS code. Required with last_name.",
            "examples": [
              "MN"
            ],
            "title": "State"
          }
        },
        "title": "CheckRequest",
        "type": "object"
      },
      "ClinicianStanding": {
        "properties": {
          "exclusions": {
            "$ref": "#/components/schemas/ExclusionScreen"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "licenses": {
            "$ref": "#/components/schemas/LicenseScreen"
          },
          "match_basis": {
            "enum": [
              "npi",
              "name_state"
            ],
            "title": "Match Basis",
            "type": "string"
          },
          "name_match": {
            "anyOf": [
              {
                "const": "exact",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set for name lookups. Matching is exact on the normalized name.",
            "title": "Name Match"
          }
        },
        "required": [
          "match_basis",
          "name_match",
          "identity",
          "exclusions",
          "licenses"
        ],
        "title": "ClinicianStanding",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ExclusionMatch": {
        "properties": {
          "action_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Date"
          },
          "action_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Type"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "match_basis": {
            "enum": [
              "npi",
              "name_dob"
            ],
            "title": "Match Basis",
            "type": "string"
          },
          "match_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Match Confidence"
          },
          "open": {
            "description": "True when no reinstatement date is recorded.",
            "title": "Open",
            "type": "boolean"
          },
          "reinstated_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reinstated Date"
          },
          "source": {
            "description": "leie | sam | npdb | state_board",
            "title": "Source",
            "type": "string"
          },
          "source_as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fetch time of that evidence row.",
            "title": "Source As Of"
          },
          "source_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Registry key of the evidence row.",
            "title": "Source Key"
          }
        },
        "required": [
          "source",
          "source_key",
          "source_as_of",
          "action_type",
          "action_date",
          "description",
          "reinstated_date",
          "open",
          "match_basis",
          "match_confidence"
        ],
        "title": "ExclusionMatch",
        "type": "object"
      },
      "ExclusionScreen": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/ExclusionMatch"
            },
            "title": "Matches",
            "type": "array"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "sources_screened": {
            "items": {
              "type": "string"
            },
            "title": "Sources Screened",
            "type": "array"
          },
          "status": {
            "enum": [
              "open_exclusion_found",
              "reinstated_exclusion_found",
              "no_npi_match",
              "not_screened"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "matches",
          "sources_screened",
          "note"
        ],
        "title": "ExclusionScreen",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Identity": {
        "properties": {
          "clinician_type": {
            "title": "Clinician Type",
            "type": "string"
          },
          "credential": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credential"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "middle_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Middle Name"
          },
          "npi": {
            "title": "Npi",
            "type": "string"
          },
          "practice_states": {
            "description": "States of the practices CMS lists this clinician at (active affiliations).",
            "items": {
              "type": "string"
            },
            "title": "Practice States",
            "type": "array"
          },
          "primary_specialty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Specialty"
          },
          "source": {
            "description": "Registry key of the source the identity comes from.",
            "title": "Source",
            "type": "string"
          },
          "suffix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suffix"
          }
        },
        "required": [
          "npi",
          "first_name",
          "middle_name",
          "last_name",
          "suffix",
          "credential",
          "clinician_type",
          "primary_specialty",
          "practice_states",
          "source"
        ],
        "title": "Identity",
        "type": "object"
      },
      "LicenseRecordOut": {
        "properties": {
          "compact_home_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compact Home State"
          },
          "discipline_reported": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the source reported discipline, when it says. Null means unknown.",
            "title": "Discipline Reported"
          },
          "expires_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires On"
          },
          "is_compact": {
            "title": "Is Compact",
            "type": "boolean"
          },
          "issued_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issued On"
          },
          "last_confirmed_at": {
            "description": "When the ingest last matched this record to the source's evidence.",
            "format": "date-time",
            "title": "Last Confirmed At",
            "type": "string"
          },
          "license_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Number"
          },
          "license_type": {
            "title": "License Type",
            "type": "string"
          },
          "source_as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source As Of"
          },
          "source_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Key"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "status": {
            "description": "active | expired | lapsed | suspended | revoked | probation",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "state",
          "license_type",
          "license_number",
          "status",
          "issued_on",
          "expires_on",
          "is_compact",
          "compact_home_state",
          "discipline_reported",
          "source_key",
          "source_as_of",
          "last_confirmed_at"
        ],
        "title": "LicenseRecordOut",
        "type": "object"
      },
      "LicenseScreen": {
        "properties": {
          "coverage": {
            "enum": [
              "no_license_source_ingested",
              "no_records_found",
              "records_found"
            ],
            "title": "Coverage",
            "type": "string"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/LicenseRecordOut"
            },
            "title": "Records",
            "type": "array"
          }
        },
        "required": [
          "coverage",
          "records",
          "note"
        ],
        "title": "LicenseScreen",
        "type": "object"
      },
      "RosterClinician": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "RN"
            ],
            "title": "Credential"
          },
          "first_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "ALPHA"
            ],
            "title": "First Name"
          },
          "last_name": {
            "examples": [
              "SAMPLE"
            ],
            "maxLength": 80,
            "title": "Last Name",
            "type": "string"
          },
          "npi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Send it when known.",
            "title": "Npi"
          }
        },
        "required": [
          "last_name"
        ],
        "title": "RosterClinician",
        "type": "object"
      },
      "RosterEmployer": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "examples": [
              "SAMPLE TEST CLINIC"
            ],
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "org_pac_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "CMS group PAC ID, when known.",
            "title": "Org Pac Id"
          }
        },
        "required": [
          "name"
        ],
        "title": "RosterEmployer",
        "type": "object"
      },
      "RosterLicense": {
        "additionalProperties": false,
        "description": "A license as the caller reports it. Recorded as a claim, never as evidence.",
        "properties": {
          "expires_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires On"
          },
          "license_number": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Number"
          },
          "license_type": {
            "examples": [
              "RN"
            ],
            "maxLength": 40,
            "minLength": 1,
            "title": "License Type",
            "type": "string"
          },
          "state": {
            "examples": [
              "MN"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "license_type"
        ],
        "title": "RosterLicense",
        "type": "object"
      },
      "RosterReceipt": {
        "properties": {
          "external_id": {
            "title": "External Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "outcome": {
            "description": "created (201), or updated / unchanged (200) for a resend.",
            "enum": [
              "created",
              "updated",
              "unchanged"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "review_status": {
            "enum": [
              "pending",
              "matched",
              "rejected"
            ],
            "title": "Review Status",
            "type": "string"
          },
          "source_system": {
            "title": "Source System",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_system",
          "external_id",
          "outcome",
          "review_status",
          "received_at",
          "updated_at",
          "note"
        ],
        "title": "RosterReceipt",
        "type": "object"
      },
      "RosterSubmission": {
        "additionalProperties": false,
        "description": "One placed clinician. ``(source_system, external_id)`` is the idempotency key:\nresending it updates the same row, and an identical resend changes nothing.",
        "properties": {
          "clinician": {
            "$ref": "#/components/schemas/RosterClinician"
          },
          "employer": {
            "$ref": "#/components/schemas/RosterEmployer"
          },
          "employment_status": {
            "default": "active",
            "enum": [
              "active",
              "ended"
            ],
            "title": "Employment Status",
            "type": "string"
          },
          "external_id": {
            "description": "The caller's own id, e.g. a placement id.",
            "maxLength": 128,
            "minLength": 1,
            "title": "External Id",
            "type": "string"
          },
          "licenses": {
            "items": {
              "$ref": "#/components/schemas/RosterLicense"
            },
            "maxItems": 50,
            "title": "Licenses",
            "type": "array"
          },
          "placed_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Placed On"
          },
          "source_system": {
            "examples": [
              "placerail"
            ],
            "title": "Source System",
            "type": "string"
          },
          "states": {
            "description": "States the clinician works or is licensed in. License states are added.",
            "items": {
              "type": "string"
            },
            "maxItems": 60,
            "title": "States",
            "type": "array"
          }
        },
        "required": [
          "source_system",
          "external_id",
          "clinician",
          "employer"
        ],
        "title": "RosterSubmission",
        "type": "object"
      },
      "SourceStatus": {
        "description": "One source this API reads or would read, and how current it is.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the newest ingested snapshot of the source was fetched.",
            "title": "As Of"
          },
          "checked": {
            "description": "True when this response read data ingested from the source.",
            "title": "Checked",
            "type": "boolean"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "freshness_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freshness Expires At"
          },
          "freshness_sla_days": {
            "title": "Freshness Sla Days",
            "type": "integer"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "reason_not_checked": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Not Checked"
          },
          "role": {
            "enum": [
              "identity",
              "exclusions",
              "licenses"
            ],
            "title": "Role",
            "type": "string"
          },
          "stale": {
            "description": "True when as_of is past the source's freshness limit.",
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "display_name",
          "role",
          "checked",
          "as_of",
          "freshness_expires_at",
          "stale",
          "freshness_sla_days"
        ],
        "title": "SourceStatus",
        "type": "object"
      },
      "SourcesBlock": {
        "description": "Which sources this answer rests on, and which it does not.",
        "properties": {
          "checked": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "title": "Checked",
            "type": "array"
          },
          "not_checked": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "title": "Not Checked",
            "type": "array"
          }
        },
        "required": [
          "checked",
          "not_checked"
        ],
        "title": "SourcesBlock",
        "type": "object"
      },
      "SourcesResponse": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "sources": {
            "$ref": "#/components/schemas/SourcesBlock"
          }
        },
        "required": [
          "checked_at",
          "scope",
          "sources"
        ],
        "title": "SourcesResponse",
        "type": "object"
      },
      "StandingResponse": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "clinicians": {
            "items": {
              "$ref": "#/components/schemas/ClinicianStanding"
            },
            "title": "Clinicians",
            "type": "array"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when result is not_found.",
            "title": "Note"
          },
          "query": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Query",
            "type": "object"
          },
          "result": {
            "enum": [
              "found",
              "not_found",
              "multiple_candidates"
            ],
            "title": "Result",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "sources": {
            "$ref": "#/components/schemas/SourcesBlock"
          },
          "truncated": {
            "description": "True when more candidates matched than were returned.",
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "result",
          "query",
          "clinicians",
          "truncated",
          "checked_at",
          "scope",
          "sources"
        ],
        "title": "StandingResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nLookups over the federal data the Clinician Standing ingest has loaded, plus one\nwrite: `POST /v1/roster`, which records a placed clinician for review.\n\nEvery lookup response carries a `sources` block. `sources.checked` lists each\nsource the answer read, with `as_of` (when that snapshot was fetched) and a\n`stale` flag. `sources.not_checked` lists the sources this API knows about but\ndid not read, with the reason. An answer covers only the checked sources.\n\nRoster intake is idempotent on `(source_system, external_id)`. Licenses sent\nthere are recorded as claims and are not verified until matched to source evidence.\n\nAuthenticate with `Authorization: Bearer <key>`.\n",
    "title": "Clinician Standing API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/clinicians": {
      "get": {
        "description": "Candidates whose name matches exactly and who practice or hold a license in\n``state``. Returns up to 25, each with its own exclusion and license screen.",
        "operationId": "by_name_v1_clinicians_get",
        "parameters": [
          {
            "in": "query",
            "name": "last_name",
            "required": true,
            "schema": {
              "maxLength": 80,
              "title": "Last Name",
              "type": "string"
            }
          },
          {
            "description": "Two-letter USPS code",
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "description": "Two-letter USPS code",
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "first_name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "First Name"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "invalid_request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "rate_limited"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "auth_not_configured or store_unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "By Name",
        "tags": [
          "standing"
        ]
      }
    },
