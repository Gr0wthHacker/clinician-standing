# =============================================================================
# clinician-standing — environment template
#
#   cp .env.example .env    then fill in the real values.
#
# WARNING
#   .env is gitignored and must stay that way. Never commit a real value from
#   this file. Production secrets live in GitHub Actions repository secrets
#   (Settings > Secrets and variables > Actions) or in a secret manager — not
#   in this repo, not in a Lovable project file, and not in a Slack message.
#   If a value here ever lands in a commit, rotate it; deleting the commit is
#   not sufficient.
# =============================================================================

# --- required ----------------------------------------------------------------

# =============================================================================
# TWO DATABASE CREDENTIALS, AND THEY ARE NOT INTERCHANGEABLE
#
#   DATABASE_URL          the ingest role. Used by every job, every month.
#   MIGRATION_DATABASE_URL  the superuser. Used by a human, running migrations.
#
# This file used to give one URI for both, naming Supabase's `postgres` role.
# That role owns every table in this schema and carries BYPASSRLS, so the
# three-role model in db/migrations/0008_rls.sql did not apply to the one
# credential the system actually uses: a leaked ingest secret read and wrote
# every row of every table, and could drop the schema. Splitting them is the
# whole point of db/migrations/0011_ingest_role.sql.
# =============================================================================

# The ingest role: app_ingest. A member of app_internal and nothing else -- it
# owns no object, has no DDL rights and has no BYPASSRLS, so every statement it
# runs is filtered by the policies in 0008. Create it by applying 0011, then set
# its password once, out of band:
#
#     psql "$MIGRATION_DATABASE_URL" -c "alter role app_ingest password '<generated>'"
#
# Use the DIRECT connection (port 5432) rather than the transaction pooler
# (6543): COPY needs session-level features that the pooler does not carry.
DATABASE_URL=postgresql://app_ingest:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres

# --- migrations only ----------------------------------------------------------

# The superuser URI, from Supabase: Project Settings > Database > Connection
# string > URI. It is needed for `make migrate` and for nothing else.
#
# KEEP IT OUT OF THE INGEST'S ENVIRONMENT. It is not set on the ingest-monthly
# workflow and must not be added to it: a scheduled job that runs unattended
# once a month has no business holding the credential that can drop the schema.
# Migrations are run by a person, from a shell, reviewing the diff first.
# Nothing reads this variable automatically; the migrate target and the psql
# loop in db/README.md take it explicitly.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Local working directory for downloaded bulk files and the raw evidence payloads
# they produce. Needs ~5GB free: the DAC file is 839MB and the revalidation file
# is 540MB, and each is held alongside the previous run for diffing.
# This path is gitignored; do not point it inside src/ or db/.
STORAGE_PATH=./storage

# --- optional ----------------------------------------------------------------

# Logging verbosity for the ingest CLI. One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Skip the download and reuse whatever is already in STORAGE_PATH. Useful when
# re-running a parse against a file you already have. "1" enables it.
INGEST_USE_CACHE=0

# Comma-separated source keys to run when no explicit argument is given.
# Matches sources.key in the database: cms_dac | oig_leie | cms_revalidation
INGEST_SOURCES=cms_dac,oig_leie,cms_revalidation

# HTTP timeout in seconds for bulk downloads. CMS is slow; do not set this low.
HTTP_TIMEOUT_SECONDS=600

# User-Agent sent on every outbound request. Identify the client honestly — this
# is a stated rule for any source whose terms we operate under.
HTTP_USER_AGENT=clinician-standing-ingest/0.1 (+https://clinicianstanding.com)

# --- future connectors (not yet implemented; leave commented) ------------------
# Uncomment only when the matching connector ships. An empty-string secret that
# looks configured is worse than an absent one.

# Nursys e-Notify. Free institution account. NOTE: the API password rotates every
# 90 days — a rotation reminder belongs in the ops calendar, not in this file.
# NURSYS_API_KEY=
# NURSYS_API_USER=
# NURSYS_INSTITUTION_ID=

# FSMB Physician Data Center. Licensed, quote required.
# FSMB_API_KEY=
# FSMB_CLIENT_ID=

# --- object storage (install with: pip install -e ".[s3]") ---------------------
# Set STORAGE_PATH to an s3://bucket/prefix URI in production. Raw evidence
# payloads are retained seven years and evidence.payload_ref points at them, so
# a local directory on a CI runner is not a storage target -- Connector.run()
# refuses to start in that configuration rather than write a dead pointer.
# AWS credentials come from the standard boto3 chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
